# Overrides for the e2e test stack. Copy to .env.test; Bun loads it on top of
# .env when NODE_ENV=test (`bun run test:server`, `bun run db:test:reset`).
# The database name must end in _test; db:test:reset refuses anything else.
# With `docker compose up -d` (docker-compose.yml creates helpdesk_test) use:
# DATABASE_URL="postgresql://postgres:postgres@localhost:5432/helpdesk_test?schema=public"
DATABASE_URL="postgresql://postgres:YOUR_PASSWORD@localhost:5432/helpdesk_test?schema=public"
PORT=3001
BETTER_AUTH_URL="http://localhost:3001"
# Must match CLIENT_URL in e2e/playwright.config.ts
CLIENT_ORIGIN="http://localhost:5174"
# Admin user seeded into the test database (password: 12+ characters)
SEED_ADMIN_EMAIL="admin@example.com"
SEED_ADMIN_PASSWORD="test-admin-password"
# Optional agent user seeded into the test database (password: 12+ characters)
SEED_AGENT_EMAIL="agent@example.com"
SEED_AGENT_PASSWORD="test-agent-password"
# Shared secret for POST /api/inbound-email (32+ characters)
INBOUND_EMAIL_SECRET="test-inbound-email-secret-0123456789"
