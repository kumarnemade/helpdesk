DATABASE_URL="postgresql://postgres:YOUR_PASSWORD@localhost:5432/helpdesk?schema=public"
# Generate with: openssl rand -base64 32
BETTER_AUTH_SECRET="CHANGE_ME"
BETTER_AUTH_URL="http://localhost:3000"
# Frontend origin allowed to call the auth API (Better Auth trustedOrigins)
CLIENT_ORIGIN="http://localhost:5173"
# Shared secret for POST /api/inbound-email (sent as "Authorization: Bearer <secret>").
# Generate with: openssl rand -base64 32
INBOUND_EMAIL_SECRET="CHANGE_ME"
# Proxies to trust for the client IP (rate limiting): a hop count like "1" or
# addresses like "loopback". Leave unset when nothing sits in front of the API.
# TRUST_PROXY="1"
# Admin user created by `bun run db:seed` (password: 12+ characters)
SEED_ADMIN_EMAIL="admin@example.com"
SEED_ADMIN_PASSWORD="CHANGE_ME"
