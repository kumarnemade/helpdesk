# With `docker compose up -d` (docker-compose.yml) use:
# DATABASE_URL="postgresql://postgres:postgres@localhost:5432/helpdesk?schema=public"
DATABASE_URL="postgresql://postgres:YOUR_PASSWORD@localhost:5432/helpdesk?schema=public"
# Generate with: openssl rand -base64 32
BETTER_AUTH_SECRET="CHANGE_ME"
BETTER_AUTH_URL="http://localhost:3000"
# Frontend origin allowed to call the auth API (Better Auth trustedOrigins)
CLIENT_ORIGIN="http://localhost:5173"
# Shared secret for POST /api/inbound-email (sent as "Authorization: Bearer <secret>").
# Generate with: openssl rand -base64 32
INBOUND_EMAIL_SECRET="CHANGE_ME"
# Gmail account the helpdesk reads email from (inbox checked every minute)
# and sends agent and AI replies from. Optional: without both, no email is
# read or sent. Turn on 2-Step Verification for the account, then create an
# App Password at https://myaccount.google.com/apppasswords (not the normal
# password; spaces are fine). Gmail sends about 500 emails a day.
# GMAIL_USER="myhelpdesk.support@gmail.com"
# GMAIL_APP_PASSWORD="abcd efgh ijkl mnop"
# Optional: send replies through the Gmail API (HTTPS) instead of SMTP, for
# hosts that block SMTP ports (e.g. Render's free plan). An OAuth client from
# Google Cloud and a refresh token for GMAIL_USER with the gmail.send scope;
# see DEPLOYMENT.md. Without all three, replies go over SMTP.
# GMAIL_CLIENT_ID="1234-abc.apps.googleusercontent.com"
# GMAIL_CLIENT_SECRET="GOCSPX-..."
# GMAIL_REFRESH_TOKEN="1//0g..."
# Proxies to trust for the client IP (rate limiting): a hop count like "1" or
# addresses like "loopback". Leave unset when nothing sits in front of the API.
# TRUST_PROXY="1"
# Or a header your proxy always overwrites with the client IP, used instead of
# TRUST_PROXY (e.g. "cf-connecting-ip" on Render). Only behind that proxy.
# CLIENT_IP_HEADER="cf-connecting-ip"
# Admin user created by `bun run db:seed` (password: 12+ characters)
SEED_ADMIN_EMAIL="admin@example.com"
SEED_ADMIN_PASSWORD="CHANGE_ME"
# Google Gemini API key for AI features (reply polishing, ticket summaries
# and auto-classification of new tickets, with gemini-3.5-flash-lite); free
# from https://aistudio.google.com/apikey. Optional: without it new tickets
# aren't classified and the polish and summary endpoints return 503.
# GOOGLE_GENERATIVE_AI_API_KEY="..."
# Sentry DSN for reporting server errors (5xx responses, failed background
# jobs, pg-boss/IMAP errors, crashes). Optional: without it nothing is sent.
# SENTRY_DSN="https://examplePublicKey@o0.ingest.sentry.io/0"
