{
  "name": "server",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "bun run --watch src/index.ts",
    "start": "bun run src/index.ts",
    "build": "bun build src/index.ts --target bun --outdir dist",
    "typecheck": "tsc --noEmit",
    "db:generate": "bun --bun prisma generate",
    "db:migrate": "bun --bun prisma migrate dev",
    "db:studio": "bun --bun prisma studio",
    "db:seed": "bun --bun prisma db seed",
    "db:test:reset": "NODE_ENV=test bun prisma/reset-test-db.ts",
    "test:server": "bun run db:test:reset && NODE_ENV=test bun run src/index.ts",
    "postinstall": "bun --bun prisma generate"
  },
  "dependencies": {
    "@prisma/adapter-pg": "7.10.0",
    "@prisma/client": "7.10.0",
    "better-auth": "^1.7.10",
    "express": "^5.3.0",
    "helmet": "^8.3.0"
  },
  "devDependencies": {
    "@types/bun": "^1.4.3",
    "@types/express": "^5.0.6",
    "prisma": "7.10.0",
    "typescript": "~6.0.2"
  }
}
