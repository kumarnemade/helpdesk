{
  "name": "server",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "bun run --watch --preload ./src/instrument.ts src/index.ts",
    "start": "bun run --preload ./src/instrument.ts src/index.ts",
    "build": "bun build src/index.ts --target bun --outdir dist",
    "typecheck": "tsc --noEmit",
    "db:generate": "bun --bun prisma generate",
    "db:migrate": "bun --bun prisma migrate dev",
    "db:deploy": "bun --bun prisma migrate deploy",
    "db:studio": "bun --bun prisma studio",
    "db:seed": "bun --bun prisma db seed",
    "db:seed:tickets": "bun --bun prisma/seed-tickets.ts",
    "db:seed:ai-agent": "bun --bun prisma/seed-ai-agent.ts",
    "db:test:reset": "NODE_ENV=test bun prisma/reset-test-db.ts",
    "test:server": "bun run db:test:reset && NODE_ENV=test bun run --preload ./src/instrument.ts src/index.ts",
    "postinstall": "bun --bun prisma generate"
  },
  "dependencies": {
    "@ai-sdk/google": "^4.0.104",
    "@prisma/adapter-pg": "7.10.0",
    "@prisma/client": "7.10.0",
    "@sentry/bun": "^11.9.0",
    "ai": "^7.0.152",
    "better-auth": "^1.7.10",
    "core": "workspace:*",
    "express": "^5.3.0",
    "helmet": "^8.3.0",
    "imapflow": "^2.9.1",
    "mailparser": "^3.12.4",
    "nodemailer": "^10.2.1",
    "pg-boss": "^12.38.0",
    "prisma": "7.10.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/bun": "^1.4.3",
    "@types/express": "^5.0.6",
    "@types/mailparser": "^3.9.0",
    "@types/nodemailer": "^8.0.2",
    "typescript": "~6.0.2"
  }
}
